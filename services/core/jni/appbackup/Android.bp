package {
    default_applicable_licenses: ["appbackup_crypto_license"],
}

license {
    name: "appbackup_crypto_license",
    visibility: [":__subpackages__"],
    license_kinds: ["SPDX-license-identifier-MIT", "SPDX-license-identifier-Apache-2.0"],
    license_text: ["libaegis/LICENSE", "argon2/LICENSE"],
}

cc_library_static {
    name: "libappbackup_crypto",
    host_supported: true,
    srcs: [
        "libaegis/src/aegis256/*.c",
        "libaegis/src/common/common.c",
        "libaegis/src/common/cpu.c",
        "libaegis/src/common/softaes.c",
        "argon2/src/argon2.c",
        "argon2/src/core.c",
        "argon2/src/encoding.c",
        "argon2/src/ref.c",
        "argon2/src/blake2/blake2b.c",
    ],
    local_include_dirs: ["libaegis/src/include", "argon2/include"],
    export_include_dirs: ["libaegis/src/include", "argon2/include"],
    cflags: ["-DARGON2_NO_THREADS", "-Wno-unused-parameter"],
}
