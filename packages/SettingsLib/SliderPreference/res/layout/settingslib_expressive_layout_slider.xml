<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:gravity="center_vertical">

    <!-- Reduced width: was @dimen/settingslib_expressive_space_medium4 (48dp),
         which reserves a generous touch target and "squeezes" the visible track.
         28dp gives comfortable space for the +/- icon without pushing the
         slider inward as much, and lines up the track with the label_frame
         (paddingStart/End 24dp) and the track_height (20dp). -->
    <FrameLayout
        android:id="@+id/icon_start_frame"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:clipChildren="false"
        android:focusable="true"
        android:visibility="gone">

        <ImageView
            android:id="@+id/icon_start"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:adjustViewBounds="true"
            android:focusable="false"
            android:tint="?android:attr/colorControlNormal"
            android:tintMode="src_in" />
    </FrameLayout>

    <com.google.android.material.slider.Slider
        android:id="@+id/slider"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:theme="@style/Theme.MaterialComponents.DayNight"
        style="@style/SettingslibSliderStyle.Expressive" />

    <FrameLayout
        android:id="@+id/icon_end_frame"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:clipChildren="false"
        android:focusable="true"
        android:visibility="gone">

        <ImageView
            android:id="@+id/icon_end"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:adjustViewBounds="true"
            android:focusable="false"
            android:tint="?android:attr/colorControlNormal"
            android:tintMode="src_in" />
    </FrameLayout>
</LinearLayout>
