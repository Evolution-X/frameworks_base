<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/clock_frame"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="start"
    android:paddingStart="24dp"
    android:paddingTop="16dp">

    <!-- Weather Row -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <com.android.systemui.weather.WeatherImageView
            android:id="@+id/weather_image"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:visibility="gone" />

        <com.android.systemui.weather.WeatherTextView
            android:id="@+id/weather_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:fontFamily="@font/Kenyen"
            android:textColor="#f9f9f9"
            android:textSize="18sp"
            android:visibility="gone" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextClock
            android:id="@+id/clock_hour"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/Neu"
            android:format12Hour="hh"
            android:format24Hour="HH"
            android:textColor="#f9f9f9"
            android:textSize="120dp" />

        <TextClock
            android:id="@+id/clock_minute"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/Neu"
            android:format12Hour="mm"
            android:format24Hour="mm"
            android:textColor="@android:color/white"
            android:textSize="120dp" />

    </LinearLayout>

    <!-- Date -->
    <TextClock
        android:id="@+id/date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="-12dp"
        android:fontFamily="@font/Kenyen"
        android:format12Hour="EEEE, MMMM dd"
        android:format24Hour="EEEE, MMMM dd"
        android:textAllCaps="true"
        android:textColor="#f9f9f9"
        android:textSize="20sp" />

</LinearLayout>